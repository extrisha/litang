<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 主小组件
  左栏：周次 / 日期+星期 / 温度 / 今日共几节
  右栏：天气一句话 + 模式切换 → 一整块列表面板
  背景由 Provider 现画 Bitmap 塞进 widget_background。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- 左栏：日期为主 -->
        <LinearLayout
            android:id="@+id/widget_left_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="2dp">

            <!-- 周次 + 日期（点击直达 App 课表） -->
            <LinearLayout
                android:id="@+id/widget_date_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_week_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_week_pill"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:shadowColor="@color/widget_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="第 9 周"
                    android:textColor="@color/widget_accent_red"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="@color/widget_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="11月14日"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_weekday_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:shadowColor="@color/widget_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="周五"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 温度：独占一行，不再和概率挤 -->
            <TextView
                android:id="@+id/widget_temp_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="12°~19°"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <!-- 今日共几节课 / 未来日显示「周几 几节」 -->
            <TextView
                android:id="@+id/widget_today_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="今日共 3 节课"
                android:textColor="@color/widget_text_faint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 中间分割线（RemoteViews 不认 View，用 ImageView） -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:background="#33FFFFFF"
            android:contentDescription="@null" />

        <!-- 右栏：天气 + 切换按钮 → 列表面板 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.66"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <!-- 天气一句话（点击就地刷新） -->
                <TextView
                    android:id="@+id/widget_weather_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="@color/widget_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="全天无雨"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_toggle_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_switch_btn_bg"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="📝 查待办"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 非今日课程时的提示 -->
            <TextView
                android:id="@+id/widget_days_ahead_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="3 天后 · 周一"
                android:textColor="@color/widget_accent_red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 一整块面板：列表与空态都在里面（深浅主题用两张 drawable 切换） -->
            <LinearLayout
                android:id="@+id/widget_list_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/widget_list_panel"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/widget_course_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="#33808080"
                        android:dividerHeight="0.7dp"
                        android:scrollbars="none" />

                    <LinearLayout
                        android:id="@+id/widget_course_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/widget_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="@color/widget_shadow"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:text="✨ 近期均无课程"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_empty_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:shadowColor="@color/widget_shadow"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:text="享受轻松大学时光 ☕"
                            android:textColor="@color/widget_text_faint"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
