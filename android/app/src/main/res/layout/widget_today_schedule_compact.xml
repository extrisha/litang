<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 紧凑版：只显示「当前/下一节课」。没有列表，所以不需要 ListView。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- 左：周次 + 星期 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compact_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_week_pill"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="第 9 周"
                android:textColor="@color/widget_accent_red"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="周五"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#33FFFFFF"
            android:contentDescription="@null" />

        <!-- 中：时间 + 课程名 / 教室 + 教师 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="08:00 高等数学（下）"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="卓越楼 405 · 张老师"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 右：天气一句话 + 温度 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <!-- 温度在上、降雨在下（用户指定顺序） -->
            <TextView
                android:id="@+id/compact_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="12°~19°"
                android:textColor="@color/widget_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="今日无雨"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
