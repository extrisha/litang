<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃底：半透明白 + 自上而下的高光渐变 + 1dp 亮边。
  Android 小组件只能画 RemoteViews，拿不到宿主桌面的背景，做不了实时模糊；
  这里用「高透明度 + 顶部高光 + 亮边」近似磨砂玻璃的观感。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#B8FFFFFF"
        android:startColor="#EAFFFFFF" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>